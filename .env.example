# Copy to .env (never commit .env). Placeholders only.
DATABASE_URL=postgresql://apricity:apricity@localhost:5432/apricity
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
# Session cookie signing secret: generate a long random string
SESSION_SECRET=change-me-to-a-long-random-string
# Seed admin (dev only): set both to create the first admin on `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SMTP: leave SMTP_HOST empty to log lead emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=info@apricitydigital.in
SMTP_FROM=
# Optional spam protection (Turnstile-ready)
TURNSTILE_SECRET=
# Resume uploads (careers form). Mount a persistent volume here in production.
UPLOAD_DIR=./uploads
